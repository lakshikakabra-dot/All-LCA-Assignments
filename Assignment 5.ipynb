    "\n",
    "def contains_certain_set_of_characters(txt):\n",
    "    return bool(re.fullmatch(r\"[a-zA-Z0-9]+\", txt))\n",
    "\n",
    "print(contains_certain_set_of_characters(\"6:30 in the morning\")) \n",
    "print(contains_certain_set_of_characters(\"Python3Programming\"))     "
